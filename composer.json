{
    "name": "basaltic-sh/sdk-php",
    "description": "Official PHP SDK for the Basaltic cloud platform",
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://basaltic.sh",
    "support": {"docs": "https://docs.basaltic.sh", "email": "security@basaltic.sh"},
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {"psr-4": {"Basaltic\\": "src/"}},
    "autoload-dev": {"psr-4": {"Basaltic\\Tests\\": "tests/"}},
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs",
        "check": ["@test", "@analyse", "@lint"]
    },
    "config": {"sort-packages": true, "allow-plugins": false, "platform": {"php": "8.3.0"}},
    "archive": {"exclude": ["/internal", "/AGENTS.md", "/.gitlab-ci.yml", "/.public-releaseignore", "/Makefile", "/RELEASING.md"]}
}
